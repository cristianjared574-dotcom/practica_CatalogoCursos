<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Vista.RegistroAlCursoActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardCursoRegistro"
        android:layout_width="358dp"
        android:layout_height="90dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@+id/txtTituloRegistroCurso"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/txtTituloRegistroCurso"
        app:layout_constraintTop_toBottomOf="@+id/txtTituloRegistroCurso">

        <androidx.cardview.widget.CardView
            android:id="@+id/cvRegistroAlCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardPreventCornerOverlap="false"
            app:layout_constraintBottom_toBottomOf="@+id/txtTituloRegistro" />

        <ImageView
            android:id="@+id/imgCursoRegistro"
            android:layout_width="94dp"
            android:layout_height="88dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="0dp"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/txtRegistroCurso"
            android:layout_width="189dp"
            android:layout_height="59dp"
            android:gravity="center"
            android:text="TextView"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgCursoRegistro"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtTituloRegistro"
        android:layout_width="312dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="@string/txtTituloRegistro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtTituloRegistroCurso"
        android:layout_width="365dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:text="@string/txtTituloRegistroCurso"
        app:layout_constraintEnd_toEndOf="@+id/txtTituloRegistro"
        app:layout_constraintHorizontal_bias="0.509"
        app:layout_constraintStart_toStartOf="@+id/txtTituloRegistro"
        app:layout_constraintTop_toBottomOf="@+id/txtTituloRegistro" />

    <TextView
        android:id="@+id/txtMatricula"
        android:layout_width="357dp"
        android:layout_height="39dp"
        android:layout_marginTop="24dp"
        android:text="@string/txtMatricula"
        app:layout_constraintEnd_toEndOf="@+id/cardCursoRegistro"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/cardCursoRegistro"
        app:layout_constraintTop_toBottomOf="@+id/cardCursoRegistro" />

    <EditText
        android:id="@+id/txtEtiMatricula"
        android:layout_width="359dp"
        android:layout_height="51dp"
        android:layout_marginTop="4dp"
        android:ems="10"
        android:inputType="text"
        android:hint="@string/txtEtiMatricula"
        app:layout_constraintEnd_toEndOf="@+id/txtMatricula"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/txtMatricula"
        app:layout_constraintTop_toBottomOf="@+id/txtMatricula" />

    <TextView
        android:id="@+id/txtFecha"
        android:layout_width="357dp"
        android:layout_height="39dp"
        android:layout_marginTop="24dp"
        android:text="@string/txtFecha"
        app:layout_constraintEnd_toEndOf="@+id/txtEtiMatricula"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/txtEtiMatricula"
        app:layout_constraintTop_toBottomOf="@+id/txtEtiMatricula" />

    <EditText
        android:id="@+id/txtEtiFechaRegistro"
        android:layout_width="358dp"
        android:layout_height="53dp"
        android:layout_marginTop="4dp"
        android:ems="10"
        android:inputType="text"
        android:hint="@string/txtEtiFechaRegistro"
        app:layout_constraintEnd_toEndOf="@+id/txtFecha"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/txtFecha"
        app:layout_constraintTop_toBottomOf="@+id/txtFecha" />

    <TextView
        android:id="@+id/txtCorreo"
        android:layout_width="357dp"
        android:layout_height="39dp"
        android:layout_marginTop="24dp"
        android:text="@string/txtCorreo"
        app:layout_constraintEnd_toEndOf="@+id/txtEtiFechaRegistro"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/txtEtiFechaRegistro"
        app:layout_constraintTop_toBottomOf="@+id/txtEtiFechaRegistro" />

    <EditText
        android:id="@+id/txtEtiCorreo"
        android:layout_width="351dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:ems="10"
        android:hint="@string/txtEtiCorreo"
        app:layout_constraintEnd_toEndOf="@+id/txtCorreo"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/txtCorreo"
        app:layout_constraintTop_toBottomOf="@+id/txtCorreo" />

    <Button
        android:id="@+id/btnConfirmarRegistro"
        android:layout_width="352dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/btnConfirmarRegistro"
        app:layout_constraintEnd_toEndOf="@+id/txtEtiCorreo"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/txtEtiCorreo"
        app:layout_constraintTop_toBottomOf="@+id/txtEtiCorreo" />

    <Button
        android:id="@+id/btnCancelarRegistro"
        android:layout_width="352dp"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/btnCancelarRegistro"
        app:layout_constraintEnd_toEndOf="@+id/btnConfirmarRegistro"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/btnConfirmarRegistro"
        app:layout_constraintTop_toBottomOf="@+id/btnConfirmarRegistro" />

</androidx.constraintlayout.widget.ConstraintLayout>